<Window x:Class="TokyoGhoulQuiz.QuizWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tokyo Ghoul | Тест"
        Height="760" Width="1280" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen" Background="#F2F2F2">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151515">
            <StackPanel>
                <Border Height="135" Background="#080808" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="東京" Foreground="White"
                                   FontSize="35" FontWeight="Bold"/>
                        <TextBlock Text="G H O U L" Foreground="#BBBBBB"
                                   FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Button Click="Home_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⌂" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Главная" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Quiz_Click" Height="105" Margin="10,5" Background="#222222">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☠" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Тест" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Ranks_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Ранги" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Ccg_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Досье CCG" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="ТЕСТИРОВАНИЕ"
                           FontSize="34" FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="QuestionNumberText"
                           Text="ВОПРОС №1" FontSize="20"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Width="850">

                <TextBlock x:Name="QuestionText"
                           FontSize="25" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,0,0,42"/>

                <StackPanel x:Name="AnswersPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <RadioButton x:Name="Answer1" GroupName="Answers"/>
                    <RadioButton x:Name="Answer2" GroupName="Answers"/>
                    <RadioButton x:Name="Answer3" GroupName="Answers"/>
                </StackPanel>

                <TextBlock x:Name="ResultText"
                           FontSize="18" FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,25,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button x:Name="SubmitButton"
                    Grid.Row="2" Content="ОТВЕТИТЬ"
                    Width="220" Height="62"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    Click="SubmitButton_Click"/>
        </Grid>
    </Grid>
    </Window>