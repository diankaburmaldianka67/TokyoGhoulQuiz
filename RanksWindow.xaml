<Window x:Class="TokyoGhoulQuiz.RanksWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Tokyo Ghoul | Ранги гулей"
        Height="760" Width="1280" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen" Background="#F2F2F2">
<Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#151515">
            <StackPanel>
                <Border Height="135" Background="#080808" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="東京" Foreground="White" FontSize="35" FontWeight="Bold"/>
                        <TextBlock Text="G H O U L" Foreground="#BBBBBB" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Button Click="Home_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⌂" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Главная" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Quiz_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☠" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Тест" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Ranks_Click" Height="105" Margin="10,5" Background="#222222">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Ранги" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Ccg_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Досье CCG" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34,25">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="850">
                <TextBlock Text="РАНГИ ГУЛЕЙ" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,28"/>
                <UniformGrid Columns="3" Rows="2">
                    <Border BorderBrush="#222222" BorderThickness="1" Margin="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="C" FontSize="38" FontWeight="Bold"/>
                            <TextBlock Text="Слабые гули"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#222222" BorderThickness="1" Margin="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="B" FontSize="38" FontWeight="Bold"/>
                            <TextBlock Text="Умеренная опасность"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#222222" BorderThickness="1" Margin="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="A" FontSize="38" FontWeight="Bold"/>
                            <TextBlock Text="Опасные гули"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#222222" BorderThickness="1" Margin="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="S" FontSize="38" FontWeight="Bold"/>
                            <TextBlock Text="Очень опасные"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#222222" BorderThickness="1" Margin="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="SS" FontSize="38" FontWeight="Bold"/>
                            <TextBlock Text="Особо опасные"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#222222" BorderThickness="1" Margin="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="SSS" FontSize="38" FontWeight="Bold"/>
                            <TextBlock Text="Наивысший уровень"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Height="347" BorderBrush="#222222" BorderThickness="1" Background="#E5E5E5" Margin="8,22,8,4">
                    <Image Source="/Images/гулигули.jpg" Stretch="UniformToFill"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
