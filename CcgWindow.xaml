<Window x:Class="TokyoGhoulQuiz.CcgWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tokyo Ghoul | Досье CCG" Height="760" Width="1280" MinHeight="650" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#F2F2F2">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151515">
            <StackPanel>
                <Border Height="135" Background="#080808" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="東京" Foreground="White"
                                   FontSize="35" FontWeight="Bold"/>
                        <TextBlock Text="G H O U L" Foreground="#BBBBBB"
                                   FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Button Click="Home_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⌂" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Главная" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Quiz_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☠" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Тест" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Ranks_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Ранги" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Ccg_Click" Height="105" Margin="10,5" Background="#222222">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Досье CCG" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="760">

            <TextBlock Text="ДОСЬЕ CCG"
                       FontSize="36" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <Border Height="490" BorderBrush="#222222"
                    BorderThickness="2" Background="#E5E5E5"
                    Margin="0,0,0,22">
                <Image Source="/Images/гулькарта.jpg" Stretch="UniformToFill"/>
            </Border>

            <TextBlock Text="CCG (Commission of Counter Ghoul) — организация, которая занимается поиском и уничтожением гулей. Её сотрудники используют куинке — оружие, созданное из какухо гулей."
                       FontSize="19" Foreground="#222222"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>


