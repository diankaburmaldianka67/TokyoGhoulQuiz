<Window x:Class="TokyoGhoulQuiz.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tokyo Ghoul | Главная" 
        Height="760" Width="1280" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen" Background="#F2F2F2">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151515">
            <StackPanel>
                <Border Height="135" Background="#080808" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="東京" Foreground="White"
                                   FontSize="35" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="G H O U L" Foreground="#BBBBBB"
                                   FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Button Click="Home_Click" Height="105" Margin="10,5" Background="#222222">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⌂" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Главная" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button Click="Quiz_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="☠" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Тест" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Ranks_Click" Height="105">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Ранги" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="Ccg_Click" Height="105" Margin="10,5">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📚" FontSize="35" TextAlignment="Center"/>
                        <TextBlock Text="Досье CCG" FontSize="13" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,25">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center" Width="760">

                <TextBlock Text="TOKYO GHOUL"
                           FontSize="42" FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="ТЕСТ НА ОПРЕДЕЛЕНИЕ ТВОЕЙ СУЩНОСТИ"
                           FontSize="17" Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,28"/>

                <Border Height="250" BorderBrush="#222222"
                        BorderThickness="2" Background="#E5E5E5"
                        Margin="0,0,0,25">
                    <Image Source="/Images/гульглвз.jpg" Stretch="UniformToFill"/>
                </Border>

                <TextBlock Text="Человек ли ты? Или в тебе уже проснулся гуль?"
                           FontSize="21" TextAlignment="Center"/>

                <Button Content="НАЧАТЬ ТЕСТ" Width="220"
                        Margin="0,28,0,0" Click="Quiz_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
